    {
      "id": 6,
      "type": "stat",
      "title": "Solve ratio",
      "description": "Validated / issued over the dashboard time range. Low means most challenged clients never solve, which is normal for scrapers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(anubis_challenges_validated{namespace=~\"$namespace\", job=\"anubis\", pod=~\"$pod\"}[$__range])) / sum(rate(anubis_challenges_issued{namespace=~\"$namespace\", job=\"anubis\", pod=~\"$pod\"}[$__range]))",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
