      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(anubis_proxied_requests_total{namespace=~\"$namespace\", job=\"anubis\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
